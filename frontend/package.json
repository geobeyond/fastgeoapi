{
  "name": "fastgeoapi-editor",
  "private": true,
  "scarfSettings": {
    "enabled": false
  },
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --config vite.pages.config.ts",
    "build:pages": "vite build --config vite.pages.config.ts",
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@radix-ui/react-tabs": "^1.2.1",
    "@rjsf/core": "^6.11.0",
    "@rjsf/utils": "^6.11.0",
    "@rjsf/validator-ajv8": "^6.11.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "maplibre-gl": "^6.16.0",
    "node-diff3": "^3.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "redoc": "^2.5.4",
    "swagger-ui-dist": "^5.34.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
